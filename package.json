{
  "name": "approval-app",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -k -n PB,VUE,SRV -c blue,green,yellow \"yarn pb\" \"yarn dev:vite\" \"yarn dev:server\"",
    "dev:vite": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:pb": "node server/pb.js",
    "pb": "pocketbase/pocketbase.exe serve --http=0.0.0.0:8091 --origins=http://localhost:3001",
    "pb:linux": "pocketbase/pocketbase serve --http=127.0.0.1:8091",
    "serve:server": "tsx server/index.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "gen:flow": "tsx scripts/gen-inventory-flow.ts",
    "backfill:company": "tsx scripts/backfillCompanyName.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@kangc/v-md-editor": "^2.3.18",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@mdi/font": "7.4.47",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^14.4.0",
    "@vxe-ui/core": "^4.4.20",
    "apexcharts": "^7.3.0",
    "md-editor-v3": "^7.1.0",
    "dayjs": "^1.11.21",
    "pinia": "^3.0.4",
    "pinyin": "^4.0.0",
    "pocketbase": "^0.27.1",
    "vue": "^3.5.30",
    "vue-clipboard3": "^2.0.0",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "vue3-apexcharts": "^1.11.1",
    "vuetify": "^4.0.2",
    "vxe-pc-ui": "4.16.27",
    "vxe-table": "^4.20.12",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@types/prismjs": "^1.26.6",
    "@unocss/transformer-directives": "^66.6.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "@vuetify/mcp": "^0.5.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.98.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "unocss": "^66.6.6",
    "unocss-preset-vuetify": "^0.2.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.2.5"
  }
}
